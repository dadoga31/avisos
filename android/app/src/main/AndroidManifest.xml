<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet para leer el buzón de correo y para mirar si hay versión
         nueva en la release «apk» de GitHub (solo descarga; la app no envía
         datos a ningún sitio). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para abrir el instalador con la APK nueva sin pasar por el navegador. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Recordatorios a su hora. USE_EXACT_ALARM se concede al instalar
         (Android 13+); en 12 basta con SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name=".AvisosApp"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/TemaAvisos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos" />
        </activity>

        <!-- specialUse y no dataSync: en Android 14 los servicios de
             sincronización se cortan a las 6 horas diarias, y la escucha
             del buzón tiene que aguantar todo el día. -->
        <service
            android:name=".correo.ServicioCorreo"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Escucha permanente del buzón de correo para crear avisos de trabajo" />
        </service>

        <receiver
            android:name=".correo.ReceptorArranque"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Alarma del recordatorio y sus botones (Empezar, Avisar en 15 min). -->
        <receiver
            android:name=".ReceptorRecordatorio"
            android:exported="false" />

        <!-- Las alarmas se pierden al reiniciar, al cambiar la hora y al actualizar. -->
        <receiver
            android:name=".ReceptorHora"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Mira dos veces al día si hay versión nueva de la app. -->
        <receiver
            android:name=".ReceptorActualizacion"
            android:exported="false" />

        <!-- Botones de las notificaciones de aviso nuevo («Me lo quedo»). -->
        <receiver
            android:name=".ReceptorAcciones"
            android:exported="false" />

        <receiver
            android:name=".WidgetAvisos"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_avisos_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_ficheros" />
        </provider>
    </application>
</manifest>
